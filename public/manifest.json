{
    "manifest_version": 3,
    "name": "Host助手",
    "version": "1.0.0",
    "action": {},
    "options_page": "config/config.html",
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "permissions": [
        "activeTab",
        "sidePanel",
        "tabs",
        "cookies",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "*://*.baidu.com/*",
        "*://*.example.com/*",
        "http://localhost:*/*",
        "ws://localhost:*/*",
        "*://*.bilibili.com/*",
        "*://*.youtube.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.baidu.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}